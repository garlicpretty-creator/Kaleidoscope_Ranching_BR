{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.kaleidoscope_ranching.pig": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.female",
            "Texture.male",
            "Texture.baby"
          ]
        }
      },
      "textures": [
        "Array.skins[q.is_baby ? 2 : (q.property('kaleidoscope_ranching:sex') == 'male')]"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "m_tusks": "!q.is_baby && q.property('kaleidoscope_ranching:sex') == 'male'"
        },
        {
          "saddle": "q.is_saddled"
        }
      ]
    }
  }
}
