{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.kaleidoscope_ranching.alpaca": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.female",
            "Texture.male",
            "Texture.baby"
          ]
        }
      },
      "textures": [
        "Array.skins[q.is_baby ? 2 : (q.property('kaleidoscope_ranching:sex') == 'male')]"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "a_torso": "!q.is_baby"
        },
        {
          "wool_coat": "!q.is_sheared"
        },
        {
          "a_tail": "!q.is_baby"
        },
        {
          "a_head": "!q.is_baby"
        },
        {
          "wool_neck": "!q.is_sheared"
        },
        {
          "m_ruff": "!q.is_baby && q.property('kaleidoscope_ranching:sex') == 'male' && !q.is_sheared"
        },
        {
          "a_leg_fl": "!q.is_baby"
        },
        {
          "wool_leg_fl": "!q.is_sheared"
        },
        {
          "a_leg_fr": "!q.is_baby"
        },
        {
          "wool_leg_fr": "!q.is_sheared"
        },
        {
          "a_leg_bl": "!q.is_baby"
        },
        {
          "wool_leg_bl": "!q.is_sheared"
        },
        {
          "a_leg_br": "!q.is_baby"
        },
        {
          "wool_leg_br": "!q.is_sheared"
        },
        {
          "b_torso": "q.is_baby"
        },
        {
          "b_tail": "q.is_baby"
        },
        {
          "b_head": "q.is_baby"
        },
        {
          "b_leg_fl": "q.is_baby"
        },
        {
          "b_leg_fr": "q.is_baby"
        },
        {
          "b_leg_bl": "q.is_baby"
        },
        {
          "b_leg_br": "q.is_baby"
        },
        {
          "lids_a": "!q.is_baby && q.property('kaleidoscope_ranching:sleeping')"
        },
        {
          "lids_b": "q.is_baby && q.property('kaleidoscope_ranching:sleeping')"
        }
      ]
    }
  }
}
