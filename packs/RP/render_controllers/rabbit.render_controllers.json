{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.kaleidoscope_ranching.rabbit": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.brown",
            "Texture.white",
            "Texture.black",
            "Texture.splotched",
            "Texture.gold",
            "Texture.salt"
          ]
        }
      },
      "textures": [
        "Array.skins[math.clamp(q.variant, 0, 5)]"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "m_cheeks": "!q.is_baby && q.property('kaleidoscope_ranching:sex') == 'male'"
        }
      ]
    }
  }
}
