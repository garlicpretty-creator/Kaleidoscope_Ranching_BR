{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.kaleidoscope_ranching.duck": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.female",
            "Texture.male",
            "Texture.baby"
          ]
        }
      },
      "textures": [
        "Array.skins[q.is_baby ? 2 : (q.property('kaleidoscope_ranching:sex') == 'male')]"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "a_torso": "!q.is_baby"
        },
        {
          "a_tail": "!q.is_baby"
        },
        {
          "m_curl": "!q.is_baby && q.property('kaleidoscope_ranching:sex') == 'male'"
        },
        {
          "a_head": "!q.is_baby"
        },
        {
          "a_wing_left": "!q.is_baby"
        },
        {
          "a_wing_right": "!q.is_baby"
        },
        {
          "a_leg_left": "!q.is_baby"
        },
        {
          "a_leg_right": "!q.is_baby"
        },
        {
          "b_torso": "q.is_baby"
        },
        {
          "b_head": "q.is_baby"
        },
        {
          "b_wing_left": "q.is_baby"
        },
        {
          "b_wing_right": "q.is_baby"
        },
        {
          "b_leg_left": "q.is_baby"
        },
        {
          "b_leg_right": "q.is_baby"
        },
        {
          "lids_a": "!q.is_baby && q.property('kaleidoscope_ranching:sleeping')"
        },
        {
          "lids_b": "q.is_baby && q.property('kaleidoscope_ranching:sleeping')"
        }
      ]
    }
  }
}
