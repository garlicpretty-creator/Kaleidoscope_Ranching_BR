{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "kaleidoscope_ranching:goat",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "female": "textures/entity/ranching/goat/female",
        "male": "textures/entity/ranching/goat/male",
        "baby": "textures/entity/ranching/goat/baby",
        "gear": "textures/entity/ranching/gear/goat"
      },
      "geometry": {
        "default": "geometry.kaleidoscope_ranching.goat",
        "gear": "geometry.kaleidoscope_ranching.goat.gear"
      },
      "animations": {
        "walk": "animation.kaleidoscope_ranching.goat.walk",
        "look_at_target": "animation.common.look_at_target",
        "sleep": "animation.kaleidoscope_ranching.goat.sleep"
      },
      "scripts": {
        "scale": "q.is_baby ? 1.0 : (q.property('kaleidoscope_ranching:sex') == 'male' ? 1.1 : 1.0)",
        "animate": [
          "walk",
          {
            "look_at_target": "!q.property('kaleidoscope_ranching:sleeping')"
          },
          {
            "sleep": "q.property('kaleidoscope_ranching:sleeping')"
          }
        ]
      },
      "render_controllers": [
        "controller.render.kaleidoscope_ranching.goat",
        {
          "controller.render.kaleidoscope_ranching.goat.gear": "q.property('kaleidoscope_ranching:gear_blanket')"
        }
      ],
      "spawn_egg": {
        "base_color": "#ECE6DA",
        "overlay_color": "#B4A88E"
      }
    }
  }
}
