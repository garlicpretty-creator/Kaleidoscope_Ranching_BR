{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "kaleidoscope_ranching:buffalo",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "female": "textures/entity/ranching/buffalo/female",
        "male": "textures/entity/ranching/buffalo/male",
        "baby": "textures/entity/ranching/buffalo/baby",
        "gear": "textures/entity/ranching/gear/buffalo"
      },
      "geometry": {
        "default": "geometry.kaleidoscope_ranching.buffalo",
        "gear": "geometry.kaleidoscope_ranching.buffalo.gear"
      },
      "animations": {
        "walk": "animation.kaleidoscope_ranching.buffalo.walk",
        "look_at_target": "animation.common.look_at_target",
        "sleep": "animation.kaleidoscope_ranching.buffalo.sleep",
        "eat": "animation.kaleidoscope_ranching.buffalo.eat",
        "drink": "animation.kaleidoscope_ranching.buffalo.drink",
        "petted": "animation.kaleidoscope_ranching.buffalo.petted",
        "graze": "animation.kaleidoscope_ranching.buffalo.graze",
        "chew": "animation.kaleidoscope_ranching.buffalo.chew",
        "actions": "controller.animation.kaleidoscope_ranching.buffalo.actions"
      },
      "scripts": {
        "scale": "q.is_baby ? 1.0 : (q.property('kaleidoscope_ranching:sex') == 'male' ? 1.15 : 1.0)",
        "animate": [
          {
            "walk": "!q.property('kaleidoscope_ranching:sleeping')"
          },
          {
            "look_at_target": "!q.property('kaleidoscope_ranching:sleeping') && q.property('kaleidoscope_ranching:action') == 'none' && !q.is_grazing"
          },
          {
            "sleep": "q.property('kaleidoscope_ranching:sleeping')"
          },
          {
            "actions": "!q.property('kaleidoscope_ranching:sleeping')"
          }
        ]
      },
      "render_controllers": [
        "controller.render.kaleidoscope_ranching.buffalo",
        {
          "controller.render.kaleidoscope_ranching.buffalo.gear": "q.property('kaleidoscope_ranching:gear_harness') || q.property('kaleidoscope_ranching:gear_plough') || q.property('kaleidoscope_ranching:gear_blanket')"
        }
      ],
      "spawn_egg": {
        "base_color": "#3C3A3A",
        "overlay_color": "#8A8478"
      }
    }
  }
}
