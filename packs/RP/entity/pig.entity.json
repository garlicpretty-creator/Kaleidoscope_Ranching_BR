{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "kaleidoscope_ranching:pig",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "female": "textures/entity/ranching/pig/female",
        "male": "textures/entity/ranching/pig/male",
        "baby": "textures/entity/ranching/pig/baby",
        "gear": "textures/entity/ranching/gear/pig"
      },
      "geometry": {
        "default": "geometry.kaleidoscope_ranching.pig",
        "gear": "geometry.kaleidoscope_ranching.pig.gear"
      },
      "animations": {
        "walk": "animation.kaleidoscope_ranching.pig.walk",
        "look_at_target": "animation.common.look_at_target",
        "sleep": "animation.kaleidoscope_ranching.pig.sleep",
        "eat": "animation.kaleidoscope_ranching.pig.eat",
        "drink": "animation.kaleidoscope_ranching.pig.drink",
        "petted": "animation.kaleidoscope_ranching.pig.petted",
        "actions": "controller.animation.kaleidoscope_ranching.pig.actions"
      },
      "scripts": {
        "scale": "q.is_baby ? 1.0 : (q.property('kaleidoscope_ranching:sex') == 'male' ? 1.1 : 1.0)",
        "animate": [
          {
            "walk": "!q.property('kaleidoscope_ranching:sleeping')"
          },
          {
            "look_at_target": "!q.property('kaleidoscope_ranching:sleeping') && q.property('kaleidoscope_ranching:action') == 'none' && !q.is_grazing"
          },
          {
            "sleep": "q.property('kaleidoscope_ranching:sleeping')"
          },
          {
            "actions": "!q.property('kaleidoscope_ranching:sleeping')"
          }
        ]
      },
      "render_controllers": [
        "controller.render.kaleidoscope_ranching.pig",
        {
          "controller.render.kaleidoscope_ranching.pig.gear": "q.property('kaleidoscope_ranching:gear_blanket')"
        }
      ],
      "spawn_egg": {
        "base_color": "#F0A8A4",
        "overlay_color": "#D49088"
      }
    }
  }
}
