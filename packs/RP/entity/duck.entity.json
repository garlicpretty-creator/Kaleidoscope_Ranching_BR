{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "kaleidoscope_ranching:duck",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "female": "textures/entity/ranching/duck/female",
        "male": "textures/entity/ranching/duck/male",
        "baby": "textures/entity/ranching/duck/baby"
      },
      "geometry": {
        "default": "geometry.kaleidoscope_ranching.duck"
      },
      "animations": {
        "walk": "animation.kaleidoscope_ranching.duck.walk",
        "look_at_target": "animation.common.look_at_target",
        "sleep": "animation.kaleidoscope_ranching.duck.sleep",
        "eat": "animation.kaleidoscope_ranching.duck.eat",
        "drink": "animation.kaleidoscope_ranching.duck.drink",
        "petted": "animation.kaleidoscope_ranching.duck.petted",
        "actions": "controller.animation.kaleidoscope_ranching.duck.actions"
      },
      "scripts": {
        "scale": "q.is_baby ? 1.0 : (q.property('kaleidoscope_ranching:sex') == 'male' ? 1.15 : 0.95)",
        "animate": [
          {
            "walk": "!q.property('kaleidoscope_ranching:sleeping')"
          },
          {
            "look_at_target": "!q.property('kaleidoscope_ranching:sleeping') && q.property('kaleidoscope_ranching:action') == 'none' && !q.is_grazing"
          },
          {
            "sleep": "q.property('kaleidoscope_ranching:sleeping')"
          },
          {
            "actions": "!q.property('kaleidoscope_ranching:sleeping')"
          }
        ]
      },
      "render_controllers": [
        "controller.render.kaleidoscope_ranching.duck"
      ],
      "spawn_egg": {
        "base_color": "#8C6A46",
        "overlay_color": "#246E3E"
      }
    }
  }
}
