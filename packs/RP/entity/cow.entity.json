{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "kaleidoscope_ranching:cow",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "female": "textures/entity/ranching/cow/female",
        "male": "textures/entity/ranching/cow/male",
        "baby": "textures/entity/ranching/cow/baby",
        "gear": "textures/entity/ranching/gear/cow"
      },
      "geometry": {
        "default": "geometry.kaleidoscope_ranching.cow",
        "gear": "geometry.kaleidoscope_ranching.cow.gear"
      },
      "animations": {
        "walk": "animation.kaleidoscope_ranching.cow.walk",
        "look_at_target": "animation.common.look_at_target",
        "sleep": "animation.kaleidoscope_ranching.cow.sleep",
        "eat": "animation.kaleidoscope_ranching.cow.eat",
        "drink": "animation.kaleidoscope_ranching.cow.drink",
        "petted": "animation.kaleidoscope_ranching.cow.petted",
        "actions": "controller.animation.kaleidoscope_ranching.cow.actions"
      },
      "scripts": {
        "scale": "q.is_baby ? 1.0 : (q.property('kaleidoscope_ranching:sex') == 'male' ? 1.15 : 1.0)",
        "animate": [
          {
            "walk": "!q.property('kaleidoscope_ranching:sleeping')"
          },
          {
            "look_at_target": "!q.property('kaleidoscope_ranching:sleeping') && q.property('kaleidoscope_ranching:action') == 'none' && !q.is_grazing"
          },
          {
            "sleep": "q.property('kaleidoscope_ranching:sleeping')"
          },
          {
            "actions": "!q.property('kaleidoscope_ranching:sleeping')"
          }
        ]
      },
      "render_controllers": [
        "controller.render.kaleidoscope_ranching.cow",
        {
          "controller.render.kaleidoscope_ranching.cow.gear": "q.property('kaleidoscope_ranching:gear_blanket')"
        }
      ],
      "spawn_egg": {
        "base_color": "#5C3C28",
        "overlay_color": "#EEE9E0"
      }
    }
  }
}
