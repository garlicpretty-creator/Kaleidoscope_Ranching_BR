{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.kaleidoscope_ranching.alpaca.actions": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "blend_transition": 0.25,
          "transitions": [
            {
              "eat": "q.property('kaleidoscope_ranching:action') == 'eat'"
            },
            {
              "drink": "q.property('kaleidoscope_ranching:action') == 'drink'"
            },
            {
              "petted": "q.property('kaleidoscope_ranching:action') == 'petted'"
            },
            {
              "graze": "q.property('kaleidoscope_ranching:action') == 'graze'"
            },
            {
              "chew": "!q.is_moving && q.property('kaleidoscope_ranching:action') == 'none' && math.mod(math.floor(q.life_time), 20) == 0"
            },
            {
              "spit": "q.property('kaleidoscope_ranching:action') == 'spit'"
            },
            {
              "shake": "!q.is_moving && q.property('kaleidoscope_ranching:action') == 'none' && math.mod(math.floor(q.life_time), 17) == 9"
            }
          ]
        },
        "eat": {
          "animations": [
            "eat"
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "done": "!(q.property('kaleidoscope_ranching:action') == 'eat') || q.state_time > 10"
            }
          ]
        },
        "drink": {
          "animations": [
            "drink"
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "done": "!(q.property('kaleidoscope_ranching:action') == 'drink') || q.state_time > 6"
            }
          ]
        },
        "petted": {
          "animations": [
            "petted"
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "done": "!(q.property('kaleidoscope_ranching:action') == 'petted') || q.state_time > 2.5"
            }
          ]
        },
        "done": {
          "transitions": [
            {
              "idle": "q.property('kaleidoscope_ranching:action') == 'none'"
            }
          ]
        },
        "graze": {
          "animations": [
            "graze"
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "done": "!(q.property('kaleidoscope_ranching:action') == 'graze') || q.state_time > 8"
            }
          ]
        },
        "spit": {
          "animations": [
            "spit"
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "done": "!(q.property('kaleidoscope_ranching:action') == 'spit') || q.state_time > 1"
            }
          ]
        },
        "shake": {
          "animations": [
            "shake"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "idle": "q.is_moving || !(q.property('kaleidoscope_ranching:action') == 'none') || q.state_time > 1.5"
            }
          ]
        },
        "chew": {
          "animations": [
            "chew"
          ],
          "blend_transition": 0.4,
          "transitions": [
            {
              "idle": "q.is_moving || !(q.property('kaleidoscope_ranching:action') == 'none') || q.state_time > 3"
            }
          ]
        }
      }
    }
  }
}
